{
  "mode": "mixed",
  "epochs": 60,
  "batch_size_all": 96,
  "batch_size_graded": 32,
  "num_workers": 4,
  "backbone_lr": 0.0001,
  "head_lr": 0.0003,
  "weight_decay": 0.0001,
  "warmup_epochs": 3,
  "schedule": "cosine",
  "grad_clip_norm": 1.0,
  "amp_dtype": "bf16",
  "early_stopping_patience": 10,
  "percentile_clip": [1.0, 99.0],
  "augment": true,
  "freeze_backbone_epochs_for_small_budgets": 5,
  "freeze_backbone_budget_threshold": 256,
  "threshold_weight": [1.0, 1.25, 1.5],
  "binary_source_weight": 0.75,
  "absent_high_threshold_weight": 0.35,
  "focal_gamma": null,
  "pos_weight_cap": 30.0,
  "oversample_graded": true
}
